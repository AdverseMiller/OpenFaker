# Publish only the application and its build inputs. Recovery material stays local.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/NOTICE.md
!/licenses/
!/.github/
!/docs/
!/gradle/
!/gradlew
!/gradlew.bat
!/gradle.properties
!/settings.gradle.kts
!/build.gradle.kts
!/app/
!/restored/

/app/*
!/app/build.gradle.kts
!/app/src/
/app/src/*
!/app/src/main/
/restored/*
!/restored/build.gradle.kts
!/restored/src/
/restored/src/*
!/restored/src/main/

# Never publish generated output, local settings or credentials.
**/build/
**/.gradle/
**/.kotlin/
**/.idea/
**/src/test/
**/src/androidTest/
local.properties
*.iml
*.apk
*.aab
*.aar
*.dex
*.jks
*.keystore
*.hprof
.DS_Store
**/recovered_app_icon.webp

# Unused recovery scaffolding stays local with the reconstruction notes.
/restored/src/main/kotlin/com/android1500/androidfaker/ui/platform/feature/profile/
/restored/src/main/kotlin/com/android1500/androidfaker/data/platform/manager/model/NotificationType.kt
/restored/src/main/kotlin/com/androidfaker/core/data/serializer/BaseEnumeratedIntSerializer.kt
/restored/src/main/kotlin/com/androidfaker/network/
/restored/src/main/kotlin/com/androidfaker/ui/platform/component/content/FakerLoadingContent.kt
/restored/src/main/kotlin/com/androidfaker/ui/platform/component/dialog/FakerLoadingDialog.kt
